{
  "name": "@reaatech/media-pipeline-mcp-cost",
  "version": "0.3.0",
  "description": "Cost tracking and budgeting — per-call recording, aggregation, preflight checks",
  "license": "MIT",
  "author": "Rick Somers <rick@reaatech.com> (https://reaatech.com)",
  "repository": {
    "type": "git",
    "url": "https://github.com/reaatech/media-pipeline-mcp.git",
    "directory": "packages/cost"
  },
  "homepage": "https://github.com/reaatech/media-pipeline-mcp/tree/main/packages/cost#readme",
  "bugs": {
    "url": "https://github.com/reaatech/media-pipeline-mcp/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@reaatech/media-pipeline-mcp-core": "workspace:*"
  },
  "devDependencies": {
    "debug": "^4.4.3",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.10"
  }
}
