{
  "name": "@reaatech/media-pipeline-mcp-provenance",
  "version": "0.3.0",
  "description": "C2PA content provenance signing — sidecar JSON manifests and in-file embedding via c2pa-node",
  "license": "MIT",
  "author": "Rick Somers <rick@reaatech.com> (https://reaatech.com)",
  "repository": {
    "type": "git",
    "url": "https://github.com/reaatech/media-pipeline-mcp.git",
    "directory": "packages/provenance"
  },
  "homepage": "https://github.com/reaatech/media-pipeline-mcp/tree/main/packages/provenance#readme",
  "bugs": {
    "url": "https://github.com/reaatech/media-pipeline-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --dts --format esm,cjs --sourcemap",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@reaatech/media-pipeline-mcp-core": "workspace:*"
  },
  "peerDependencies": {
    "c2pa-node": "^0.5.0",
    "@aws-sdk/client-kms": "^3.0.0",
    "@google-cloud/kms": "^4.0.0",
    "@azure/keyvault-keys": "^4.0.0",
    "@azure/identity": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "c2pa-node": {
      "optional": true
    },
    "@aws-sdk/client-kms": {
      "optional": true
    },
    "@google-cloud/kms": {
      "optional": true
    },
    "@azure/keyvault-keys": {
      "optional": true
    },
    "@azure/identity": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  }
}
