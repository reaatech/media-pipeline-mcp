{
  "name": "@reaatech/media-pipeline-mcp-keyvault",
  "version": "0.3.0",
  "description": "Multi-tenant API key vault — AWS Secrets Manager, GCP Secret Manager, environment variables, in-memory backends",
  "license": "MIT",
  "author": "Rick Somers <rick@reaatech.com> (https://reaatech.com)",
  "repository": {
    "type": "git",
    "url": "https://github.com/reaatech/media-pipeline-mcp.git",
    "directory": "packages/keyvault"
  },
  "homepage": "https://github.com/reaatech/media-pipeline-mcp/tree/main/packages/keyvault#readme",
  "bugs": {
    "url": "https://github.com/reaatech/media-pipeline-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --dts --format esm,cjs --sourcemap",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@reaatech/media-pipeline-mcp-core": "workspace:*"
  },
  "peerDependencies": {
    "@aws-sdk/client-secrets-manager": "^3.0.0",
    "@google-cloud/secret-manager": "^6.1.2"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-secrets-manager": { "optional": true },
    "@google-cloud/secret-manager": { "optional": true }
  },
  "devDependencies": {
    "@aws-sdk/client-secrets-manager": "^3.0.0",
    "@google-cloud/secret-manager": "^6.1.2",
    "@types/node": "^25.9.1",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  }
}
